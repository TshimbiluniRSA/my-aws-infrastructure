# Reauthenticate to AWS, then list engine versions currently available in eu-west-1:
# aws rds describe-db-engine-versions --region eu-west-1 --engine postgres \
#   --query 'DBEngineVersions[?Status==`available`].EngineVersion' --output text
#
# Set a version from that regional catalog before planning or applying:
# postgres_engine_version = "REPLACE_WITH_CONFIRMED_VERSION"

# Optional EC2 overrides (defaults shown):
# ec2_instance_type              = "t3.micro"
# ec2_root_volume_size           = 16
# ec2_enable_detailed_monitoring = false
